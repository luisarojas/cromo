# Hoist tslib so deeply-nested AWS SDK transitive deps (e.g. @aws-crypto/crc32c)
# can `require('tslib')` from the workspace root. Without this, pnpm's strict
# resolution leaves tslib unfindable by packages that don't declare it as a
# direct dep.
public-hoist-pattern[]=tslib

# pnpm v10 requires inject-workspace-packages for deploy by default.
# force-legacy-deploy restores the pre-v10 behaviour for the Dockerfile deploy
# step without changing how workspace symlinks work during local development.
force-legacy-deploy=true
