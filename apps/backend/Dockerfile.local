FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate

WORKDIR /app

# Copy workspace manifests for dependency resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/backend/package.json ./apps/backend/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy shared package source + tsconfig (so `pnpm --filter @cromo/shared
# typecheck` actually finds a tsconfig inside the container)
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src/ ./packages/shared/src/

# Copy backend config and source (src/ is overridden by volume mount at runtime)
COPY apps/backend/tsconfig.json apps/backend/drizzle.config.ts apps/backend/eslint.config.js ./apps/backend/
COPY apps/backend/src/ ./apps/backend/src/

WORKDIR /app/apps/backend

EXPOSE 3001

# Reconcile workspace deps against the (bind-mounted) manifests on every boot
# before starting the dev server, so a stale node_modules volume can never
# diverge from package.json/pnpm-lock.yaml. A no-op when already in sync.
CMD ["sh", "-c", "pnpm -C /app install --frozen-lockfile && exec pnpm dev"]
