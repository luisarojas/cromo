FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate

WORKDIR /app

# Copy workspace manifests for dependency resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/backend/package.json ./apps/backend/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy shared package source + tsconfig (so `pnpm --filter @cromo/shared
# typecheck` actually finds a tsconfig inside the container)
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src/ ./packages/shared/src/

# Copy backend config and source (src/ is overridden by volume mount at runtime)
COPY apps/backend/tsconfig.json apps/backend/drizzle.config.ts apps/backend/eslint.config.js ./apps/backend/
COPY apps/backend/src/ ./apps/backend/src/

WORKDIR /app/apps/backend

EXPOSE 3001

# Reconcile workspace deps against the (bind-mounted) manifests on every boot,
# build @cromo/shared so the backend can `import` real .js at runtime (the
# package no longer ships raw .ts — see packages/shared/package.json), then
# start the dev server. A background `tsc --watch` keeps shared rebuilt as
# packages/shared/src changes during development.
CMD ["sh", "-c", "pnpm -C /app install --frozen-lockfile && pnpm -C /app/packages/shared build && (pnpm -C /app/packages/shared build:watch &) && exec pnpm dev"]
