FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate

WORKDIR /app

# Copy workspace manifests for dependency resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/frontend/package.json ./apps/frontend/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy shared package source + tsconfig
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src/ ./packages/shared/src/

# Copy frontend config and source (src/ is overridden by volume mount at runtime)
COPY apps/frontend/next.config.ts apps/frontend/tsconfig.json apps/frontend/tailwind.config.ts apps/frontend/postcss.config.js ./apps/frontend/
COPY apps/frontend/public/ ./apps/frontend/public/
COPY apps/frontend/messages/ ./apps/frontend/messages/
COPY apps/frontend/src/ ./apps/frontend/src/

WORKDIR /app/apps/frontend

EXPOSE 3000

# Reconcile workspace deps and build @cromo/shared (the package now ships
# its compiled .js/.d.ts from dist/ rather than raw .ts — see
# packages/shared/package.json), then start Next. A background tsc --watch
# keeps shared rebuilt as packages/shared/src changes during development.
CMD ["sh", "-c", "pnpm -C /app install --frozen-lockfile && pnpm -C /app/packages/shared build && (pnpm -C /app/packages/shared build:watch &) && exec pnpm dev"]
