{
  "name": "cromo",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "docker compose -f infrastructure/docker/docker-compose.yml exec -T api pnpm run db:migrate",
    "db:generate": "docker compose -f infrastructure/docker/docker-compose.yml exec api pnpm run db:generate",
    "db:seed": "bash scripts/seed-database.sh",
    "db:reset": "docker compose -f infrastructure/docker/docker-compose.yml exec -T api pnpm run db:reset && bash scripts/seed-database.sh",
    "db:studio": "pnpm --filter @cromo/backend db:studio",
    "load-test": "docker run --rm -i --network host -v $PWD/infrastructure/loadtest:/loadtest grafana/k6 run /loadtest/k6-smoke.js"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "brace-expansion@>=1.0.0 <1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild@<0.28.1": "^0.28.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "js-yaml@<=4.1.1": "^4.2.0",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "postcss@<8.5.10": "^8.5.10",
      "qs@<6.15.2": "^6.15.2",
      "rollup@>=3.0.0 <3.30.0": "^3.30.0",
      "uuid@<11.1.1": "^11.1.1",
      "vite@<6.4.2": "^6.4.2"
    }
  }
}
