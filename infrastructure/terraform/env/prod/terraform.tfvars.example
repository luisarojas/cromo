# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
#
# IMPORTANT: this is the production environment. Double-check every value
# before `terraform apply`. Treat this file like a checklist.

account_id   = "123456789012"
apex_domain  = "cromotrade.ca"
ecr_registry = "123456789012.dkr.ecr.ca-central-1.amazonaws.com"

# Use a real on-call distribution list, not a personal inbox.
alert_email = "oncall@cromotrade.ca"

# Generate with: openssl rand -base64 32
# This signs internal short-lived tokens. Cognito tokens are RS256-verified
# via JWKS, so this secret does NOT gate user authentication directly.
jwt_secret = "REPLACE_WITH_RANDOM_32_BYTE_BASE64"

# AI scanning. scan_provider picks which backend is called; only the matching
# api key needs to be a real value, the other can stay 'mock'. Setting the
# matching key to 'mock' WILL brick AI scanning in prod. See the 'AI Scan
# Provider' section in CLAUDE.md for the trade-offs between Gemini Flash and
# Groq Llama.
scan_provider  = "gemini"
gemini_api_key = "REPLACE_WITH_REAL_GEMINI_KEY"
groq_api_key   = "mock"
# Optional. Leave empty to use the code-side default per provider
# (gemini-2.5-flash, meta-llama/llama-4-maverick-17b-128e-instruct).
# Set to e.g. "gemini-2.5-pro" or
# "meta-llama/llama-4-scout-17b-16e-instruct" to override without a redeploy.
scan_model     = ""

# GitHub repo slug allowed to assume the prod deploy role (OIDC). Only v*
# tag pushes from this repo can deploy to prod.
github_repo = "Luisarojas/cromo"

# Bootstrapped admin(s). Each email is created in the Cognito pool and added to
# the 'admin' group (→ role=admin in the backend). On first login the admin
# sets a real password via the "Forgot password" flow, which clears the
# temporary one. admin_temp_password must satisfy the pool policy
# (12+ chars, upper, lower, number).
admin_emails        = ["r.luisaf@gmail.com"]
admin_temp_password = "REPLACE_WITH_TEMP_PASSWORD_12+_CHARS"
