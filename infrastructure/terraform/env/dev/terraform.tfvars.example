# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.

account_id   = "123456789012"
apex_domain  = "cromotrade.ca"
ecr_registry = "123456789012.dkr.ecr.ca-central-1.amazonaws.com"
alert_email  = "alerts@example.com"

# Generate with: openssl rand -base64 32
jwt_secret = "REPLACE_WITH_RANDOM_32_BYTE_BASE64"

# AI scanning. scan_provider picks which backend is called; only the matching
# api key needs to be a real value, the other can stay 'mock'. See the
# 'AI Scan Provider' section in CLAUDE.md for the trade-offs between
# Gemini Flash and Groq Llama.
scan_provider  = "gemini"
gemini_api_key = "REPLACE_WITH_REAL_GEMINI_KEY"
groq_api_key   = "mock"

# WC 2026 standings. 'mock' keeps the page on deterministic sample data;
# a real football-data.org key (https://www.football-data.org/client/register)
# switches it to live fixtures, results, and rosters (WC_DATA_PROVIDER=football-data).
wc_api_key = "mock"
# Optional. Leave empty to use the code-side default per provider
# (gemini-2.5-flash, meta-llama/llama-4-scout-17b-16e-instruct).
# Set to e.g. "gemini-2.5-pro" to override without a redeploy.
scan_model     = ""

# GitHub repo slug allowed to assume the deploy role (OIDC). Dev trusts
# pushes to main.
github_repo = "luisarojas/cromo"

# Bootstrapped admin(s). Each email is created in the Cognito pool and added to
# the 'admin' group (→ role=admin in the backend). On first login the admin
# sets a real password via the "Forgot password" flow, which clears the
# temporary one. admin_temp_password must satisfy the pool policy
# (12+ chars, upper, lower, number).
admin_emails        = ["r.luisaf@gmail.com"]
admin_temp_password = "REPLACE_WITH_TEMP_PASSWORD_12+_CHARS"

# IAM users that can operate dev from a laptop (SSM port-forward into RDS,
# read cromo/dev/app from Secrets Manager). Access keys are created in the
# AWS console after apply — not in Terraform — so they don't land in state.
developer_iam_users = ["luisa"]
