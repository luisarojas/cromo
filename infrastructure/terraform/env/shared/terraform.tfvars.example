# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
#
# This composition owns the hosted zone and SES identity. They outlive any
# specific environment — nuking dev or prod doesn't touch them.

dmarc_report_email = "alerts@example.com"

# ─── Namecheap Private Email (inbound mailboxes for cromotrade.ca) ───────────
# Flip enable_namecheap_mail to true after buying Private Email Starter
# at Namecheap (~$11/yr, one mailbox + aliases). The module publishes
# the MX + autodiscover records on apply; Namecheap's verifier sees the
# MX point at privateemail.com and auto-marks the domain verified.
#
# After enabling DKIM in Namecheap's Private Email admin, paste the
# public key into namecheap_dkim_public_key and apply again to
# publish the DKIM TXT.
#
# enable_namecheap_mail      = true
# namecheap_dkim_selector    = "default"          # whatever Namecheap's UI shows; usually `default`
# namecheap_dkim_public_key  = "MIGfMA0GCSq..."   # base64 body only, from Namecheap admin → DKIM
